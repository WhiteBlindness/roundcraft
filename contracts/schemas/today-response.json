{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roundcraft.app/contracts/today-response.json",
  "title": "Today response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "data", "error", "meta"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "edition"],
          "properties": {
            "availability": { "const": "available" },
            "edition": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edition_id",
                "case_number",
                "edition_date_utc",
                "estimated_minutes",
                "focus",
                "status",
                "primary_action",
                "origin",
                "origin_label"
              ],
              "properties": {
                "edition_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$",
                  "maxLength": 80
                },
                "case_number": { "type": "integer", "minimum": 1 },
                "edition_date_utc": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "estimated_minutes": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 8
                },
                "focus": { "type": "string", "minLength": 1, "maxLength": 80 },
                "status": {
                  "enum": [
                    "new",
                    "in_progress",
                    "result_pending",
                    "update_required",
                    "decision_complete",
                    "complete",
                    "corrected",
                    "withdrawn"
                  ]
                },
                "primary_action": {
                  "enum": [
                    "start_case",
                    "continue",
                    "retry_result",
                    "refresh_case",
                    "view_debrief",
                    "review",
                    "read_correction",
                    "view_neutral_record"
                  ]
                },
                "origin": { "enum": ["synthetic", "professional"] },
                "origin_label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "edition", "status", "primary_action"],
          "properties": {
            "availability": { "const": "unavailable" },
            "edition": { "type": "null" },
            "status": { "const": "unavailable" },
            "primary_action": { "const": "retry_later" }
          }
        }
      ]
    },
    "error": { "type": "null" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "api_version"],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "api_version": { "const": "v1" }
      }
    }
  }
}
