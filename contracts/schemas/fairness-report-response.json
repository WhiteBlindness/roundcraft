{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roundcraft.app/contracts/fairness-report-response.json",
  "title": "Fairness report response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "data", "error", "meta"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id"],
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "error": { "type": "null" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "api_version"],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "api_version": { "const": "v1" }
      }
    }
  }
}
