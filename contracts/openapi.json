{
  "openapi": "3.1.0",
  "info": {
    "title": "Roundcraft API",
    "version": "0.4.0",
    "description": "Public contract covering the full game flow, history, progress, archive, fairness and analytics."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/session": {
      "post": {
        "operationId": "createOrRenewSession",
        "summary": "Issue or renew a pseudonymous session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0,
                "additionalProperties": false
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session context",
            "headers": {
              "Set-Cookie": {
                "schema": { "type": "string" },
                "description": "Secure __Host-roundcraft identity cookie"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/session-response.json" },
                "examples": {
                  "success": {
                    "externalValue": "./examples/session.success.json"
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/today": {
      "get": {
        "operationId": "getToday",
        "summary": "Return only the current public edition cover",
        "responses": {
          "200": {
            "description": "Current public cover or neutral unavailable state. Varies by session, so it is sent with Cache-Control: private, no-cache and an ETag for revalidation.",
            "headers": {
              "Cache-Control": { "schema": { "const": "private, no-cache" } },
              "ETag": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/today-response.json" },
                "examples": {
                  "available": {
                    "externalValue": "./examples/today.success.json"
                  },
                  "unavailable": {
                    "externalValue": "./examples/today.unavailable.json"
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/attempts": {
      "post": {
        "operationId": "createOrResumeAttempt",
        "summary": "Create or resume the official attempt for a released edition",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["edition_id"],
                "properties": {
                  "edition_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical official attempt and its published briefing",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/attempt-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/attempt.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/attempts/{attempt_id}": {
      "get": {
        "operationId": "getAttempt",
        "summary": "Resume an owned active attempt",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned attempt and its currently authorised projection",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/attempt-response.json" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeError" },
          "410": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/attempts/{attempt_id}/main-commit": {
      "post": {
        "operationId": "commitMainAnswer",
        "summary": "Immutably lock the main answer and release the public follow-up",
        "description": "The answer is locked only when the server can score it. If the edition content cannot score the submitted answer, the call returns 503 SERVICE_UNAVAILABLE and the attempt stays unlocked.",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "const": "\"0\"" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["case_revision", "action_id", "qualifier_id", "evidence_ids", "confidence_id"],
                "properties": {
                  "case_revision": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
                  "action_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
                  "qualifier_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 }
                  },
                  "confidence_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The immutable main answer and newly authorised follow-up",
            "headers": {
              "ETag": { "schema": { "const": "\"1\"" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/main-commit-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/main-commit.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeError" },
          "409": { "$ref": "#/components/responses/SafeError" },
          "410": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/attempts/{attempt_id}/followup-commit": {
      "post": {
        "operationId": "commitFollowupAnswer",
        "summary": "Immutably lock the follow-up, calculate the result and release the public debrief",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "const": "\"1\"" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["case_revision", "type", "response_id"],
                    "properties": {
                      "case_revision": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
                      "type": { "const": "new_information" },
                      "response_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["case_revision", "type", "posture_id", "priority_id"],
                    "properties": {
                      "case_revision": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
                      "type": { "const": "economy_risk" },
                      "posture_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
                      "priority_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The frozen result and newly authorised public debrief",
            "headers": {
              "ETag": { "schema": { "const": "\"2\"" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/followup-commit-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/followup-commit.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeError" },
          "409": { "$ref": "#/components/responses/SafeError" },
          "410": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/attempts/{attempt_id}/debrief-complete": {
      "post": {
        "operationId": "completeDebrief",
        "summary": "Record the player's explicit completion of the authorised review",
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "const": "\"2\"" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0,
                "additionalProperties": false
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted review-completion milestone",
            "headers": {
              "ETag": { "schema": { "const": "\"3\"" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/debrief-complete-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/debrief-complete.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeError" },
          "409": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/practice-attempts": {
      "post": {
        "operationId": "createPracticeAttempt",
        "summary": "Create a new practice attempt for a released edition",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["edition_id"],
                "properties": {
                  "edition_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Newly created practice attempt and its published briefing",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/practice-attempt-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/practice-attempt.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/history": {
      "delete": {
        "operationId": "deleteHistory",
        "summary": "Delete all server-side data for the current identity",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Neutral confirmation of deletion",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/history-delete-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/history-delete.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "409": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/progress": {
      "get": {
        "operationId": "getProgress",
        "summary": "Return the scored history for the current identity",
        "responses": {
          "200": {
            "description": "Scored editions for this identity",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/progress-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/progress.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/cases": {
      "get": {
        "operationId": "listCases",
        "summary": "List released editions in reverse chronological order",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 80 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Released editions with public metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/cases-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/cases.success.json" }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/fairness-reports": {
      "post": {
        "operationId": "createFairnessReport",
        "summary": "Submit a structured fairness report for an edition",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attempt_id", "category"],
                "properties": {
                  "attempt_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  },
                  "category": {
                    "enum": [
                      "missing_action",
                      "missing_qualifier",
                      "missing_evidence",
                      "incorrect_disclosed_fact",
                      "other"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Neutral confirmation of the report",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/fairness-report-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/fairness-report.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "404": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    },
    "/events": {
      "post": {
        "operationId": "recordEvent",
        "summary": "Record a permitted product analytics event",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event_name", "properties"],
                "properties": {
                  "event_name": {
                    "enum": [
                      "today_loaded",
                      "attempt_issued",
                      "attempt_resumed",
                      "state_reached",
                      "main_committed",
                      "followup_committed",
                      "decision_complete",
                      "debrief_opened",
                      "debrief_complete",
                      "sources_opened",
                      "share_invoked",
                      "fairness_reported",
                      "return_visit"
                    ]
                  },
                  "properties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "edition_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+$",
                        "maxLength": 80
                      },
                      "mode": { "enum": ["official", "practice"] },
                      "assisted": { "type": "boolean" },
                      "state_name": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+$",
                        "maxLength": 40
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^[a-z0-9_.]+$",
                        "maxLength": 40
                      },
                      "surface": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+$",
                        "maxLength": 40
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "./schemas/events-response.json" },
                "examples": {
                  "success": { "externalValue": "./examples/events.success.json" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/SafeError" },
          "403": { "$ref": "#/components/responses/SafeError" },
          "422": { "$ref": "#/components/responses/SafeError" },
          "429": { "$ref": "#/components/responses/SafeError" },
          "503": { "$ref": "#/components/responses/SafeError" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "SafeError": {
        "description": "Safe versioned error envelope",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok", "data", "error", "meta"],
              "properties": {
                "ok": { "const": false },
                "data": { "type": "null" },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "message"],
                  "properties": {
                    "code": {
                      "enum": [
                        "INVALID_REQUEST",
                        "SESSION_INVALID",
                        "REQUEST_FORBIDDEN",
                        "RATE_LIMITED",
                        "NO_CURRENT_EDITION",
                        "ATTEMPT_NOT_FOUND",
                        "ATTEMPT_EXPIRED",
                        "IDEMPOTENCY_KEY_REUSED",
                        "VERSION_CONFLICT",
                        "ATTEMPT_STATE_CONFLICT",
                        "VALIDATION_ERROR",
                        "NOT_FOUND",
                        "INTERNAL_ERROR",
                        "SERVICE_UNAVAILABLE"
                      ]
                    },
                    "message": { "type": "string", "maxLength": 160 }
                  }
                },
                "meta": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["request_id", "api_version"],
                  "properties": {
                    "request_id": { "type": "string" },
                    "api_version": { "const": "v1" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
