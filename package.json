{
  "name": "roundcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run types:worker && tsc --noEmit && vite build",
    "preview": "vite preview",
    "types:worker": "wrangler types src/worker/worker-configuration.d.ts",
    "typecheck": "npm run types:worker && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:contract && npm run test:content && npm run test:worker && npm run test:client",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:content": "vitest run --config vitest.content.config.ts && vitest run --config vitest.content-d1.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:coverage": "npm run test:coverage:worker && npm run test:coverage:client",
    "test:coverage:worker": "vitest run --coverage --config vitest.worker.config.ts",
    "test:coverage:client": "vitest run --coverage --config vitest.client.config.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply roundcraft-prod --local",
    "content:validate": "node --no-warnings=ExperimentalWarning --import ./scripts/content/register.mjs scripts/content/validate.ts",
    "content:build": "node --no-warnings=ExperimentalWarning --import ./scripts/content/register.mjs scripts/content/build.ts",
    "content:preview": "node --no-warnings=ExperimentalWarning --import ./scripts/content/register.mjs scripts/content/preview.ts",
    "content:score": "node --no-warnings=ExperimentalWarning --import ./scripts/content/register.mjs scripts/content/score-lines.ts"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
